  "discoverer": "Adolph Strecker",
  "overview": "醛或酮与氨、氰化氢（或氰化物）缩合，生成 α-氨基腈，水解后得到 α-氨基酸——最经典的氨基酸合成路线。",
  "scheme_simple": "PhCHO + NH3 + HCN → PhCH(NH2)CN →(H3O+) PhCH(NH2)COOH",
  "scheme_above": "NH3, HCN（或 KCN）",
  "scheme_below": "H2O/EtOH, 25 ℃",
  "scheme_image": "strecker-synthesis",
  "substrates": [
    "醛（脂肪/芳香）",
    "酮（得 α-氨基酸）"
  ],

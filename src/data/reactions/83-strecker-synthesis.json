    "α-氨基腈",
    "α-氨基酸（水解后）"
  ],
  "catalyst": "—",
  "reagent": "HCN / KCN + NH3",
  "base": "—",
  "solvent": [
    "H2O",
    "EtOH"
  ],
  "temp": "0 ~ 25 ℃",
  "time": "待核对",
  "atmosphere": "无特殊要求",
  "mechanism_steps": [
    "氨与醛缩合，生成亚胺",
    "氰离子对亚胺做亲核加成，得到 α-氨基腈",
    "强酸/强碱水解腈基，得到 α-氨基酸"
  ],
  "regio_selectivity": "氨基与氰基加在同一个碳上（原羰基碳）",
  "stereo_selectivity": "生成外消旋的 α-氨基酸；手性辅基/酶法可实现不对称",
  "selectivity_note": "是合成非天然氨基酸最直接的方法；氰化物剧毒，操作需谨慎",
  "scope": "α-氨基酸、氨基腈中间体",
  "limitations": "氰化物剧毒；产物外消旋；酮底物位阻大时收率低",
  "examples": [
    "苯甲醛 → 苯甘氨酸（产率待核对）",
    "环己酮 → 1-氨基环己烷甲酸（产率待核对）"
  ],
  "pitfalls": [
    "把水解写成一步：腈要先变成羧酸，条件较强",
    "忽略产物是外消旋体"
  ],
  "mnemonics": "醛 + 氨 + 氰 → 氨基腈 → 水解 → 氨基酸。",
